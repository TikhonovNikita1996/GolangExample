# ----------------------------
# Настройки логгера
# ----------------------------

# Уровень логирования (debug, info, warn, error)
LOGGER_LEVEL=${INVENTORY_LOGGER_LEVEL}

# Выводить логи в формате JSON (true/false)
LOGGER_AS_JSON=${INVENTORY_LOGGER_AS_JSON}

# ----------------------------
# Настройки PostgreSQL
# ----------------------------

# Пользователь
POSTGRES_USER=${ORDER_POSTGRES_USER}
# Пароль
POSTGRES_PASSWORD=${ORDER_POSTGRES_PASSWORD}
# Хост для подключения
POSTGRES_HOST=${ORDER_POSTGRES_HOST}
# Порт для подключения
POSTGRES_PORT=${ORDER_POSTGRES_PORT}
# Папка с миграциями
POSTGRES_MIGRATIONS_DIR=${ORDER_MIGRATIONS_DIR}
# Имя базы данных
POSTGRES_DATABASE=${ORDER_POSTGRES_DATABASE}

# ----------------------------
# Настройки Redis
# ----------------------------

# Хост Redis-сервера
REDIS_HOST=${UFO_REDIS_HOST}

# Внешний порт Redis (для подключения извне контейнера)
REDIS_PORT=${UFO_REDIS_PORT}

# Внешний порт Redis (для подключения извне контейнера)
EXTERNAL_REDIS_PORT=${UFO_EXTERNAL_REDIS_PORT}

# Таймаут подключения к Redis
REDIS_CONNECTION_TIMEOUT=${UFO_REDIS_CONNECTION_TIMEOUT}

# Максимальное количество неиспользуемых соединений в пуле
REDIS_MAX_IDLE=${UFO_REDIS_MAX_IDLE}

# Время, через которое неиспользуемое соединение считается устаревшим
REDIS_IDLE_TIMEOUT=${UFO_REDIS_IDLE_TIMEOUT}

# Время жизни записи в кеше
REDIS_CACHE_TTL=${UFO_REDIS_CACHE_TTL}