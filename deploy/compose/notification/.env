# ----------------------------
# Настройки логгера
# ----------------------------

# Уровень логирования (debug, info, warn, error)
LOGGER_LEVEL=info

# Выводить логи в формате JSON (true/false)
LOGGER_AS_JSON=true

# ----------------------------
# Настройки kafka
# ----------------------------

# Адреса Kafka-брокеров через запятую
KAFKA_BROKERS=localhost:9092

# Название топика с событиями "Заказ оплачен"
ORDER_PAID_TOPIC_NAME=order.paid

# Название топика с событиями "Заказ оплачен"
ASSEMBLY_SHIP_ASSEMBLED_TOPIC_NAME=ship.assembled

# Идентификатор consumer group для обработки событий "Заказ оплачен"
NOTIFICATION_ORDER_PAID_CONSUMER_GROUP_ID=4

# Идентификатор consumer group для обработки событий "Сборка корабля"
NOTIFICATION_SHIP_ASSEMBLED_CONSUMER_GROUP_ID=5

