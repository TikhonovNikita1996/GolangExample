# ----------------------------
# Настройки логгера
# ----------------------------

# Уровень логирования (debug, info, warn, error)
LOGGER_LEVEL=info

# Выводить логи в формате JSON (true/false)
LOGGER_AS_JSON=true

# ----------------------------
# Настройки PostgreSQL
# ----------------------------

# Пользователь
POSTGRES_USER=demo
# Пароль
POSTGRES_PASSWORD=demo
# Хост для подключения
POSTGRES_HOST=localhost
# Порт для подключения
POSTGRES_PORT=5432
# Папка с миграциями
POSTGRES_MIGRATIONS_DIR=./order/migrations
# Имя базы данных
POSTGRES_DATABASE=postgres

# ----------------------------
# Настройки Redis
# ----------------------------

# Хост Redis-сервера
REDIS_HOST=localhost

# Внешний порт Redis (для подключения извне контейнера)
REDIS_PORT=6333

# Внешний порт Redis (для подключения извне контейнера)
EXTERNAL_REDIS_PORT=6333

# Таймаут подключения к Redis
REDIS_CONNECTION_TIMEOUT=10s

# Максимальное количество неиспользуемых соединений в пуле
REDIS_MAX_IDLE=10

# Время, через которое неиспользуемое соединение считается устаревшим
REDIS_IDLE_TIMEOUT=10s

# Время жизни записи в кеше
REDIS_CACHE_TTL=24h