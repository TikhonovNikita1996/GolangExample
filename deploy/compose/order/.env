# ----------------------------
# Настройки HTTP-сервера
# ----------------------------

# Адрес, на котором будет слушать HTTP-сервер
HTTP_HOST=localhost

# Порт, на котором будет работать gRPC-сервер
HTTP_PORT=8080

# Таймаут на чтение Header
HTTP_READ_HEADER_TIMEOUT=5s

# Shutdown timeout
HTTP_SHUTDOWN_TIMEOUT=10s

# ----------------------------
# Настройки логгера
# ----------------------------

# Уровень логирования (debug, info, warn, error)
LOGGER_LEVEL=info

# Выводить логи в формате JSON (true/false)
LOGGER_AS_JSON=true

# ----------------------------
# Настройки PostgreSQL
# ----------------------------

# Пользователь
POSTGRES_USER=demo
# Пароль
POSTGRES_PASSWORD=demo
# Хост для подключения
POSTGRES_HOST=localhost
# Порт для подключения
POSTGRES_PORT=5432
# Папка с миграциями
POSTGRES_MIGRATIONS_DIR=./order/migrations
# Имя базы данных
POSTGRES_DATABASE=postgres

# ----------------------------
# Настройки подключения к другим сервисам
# ----------------------------

## Inventory сервис
# Адрес, на котором будет слушать HTTP-сервер
INVENTORY_GRPC_HOST=localhost

# Порт, на котором будет работать gRPC-сервер
INVENTORY_GRPC_PORT=50052

## Payment сервис
# Адрес, на котором будет слушать HTTP-сервер
PAYMENT_GRPC_HOST=localhost

# Порт, на котором будет работать gRPC-сервер
PAYMENT_GRPC_PORT=50051

# Адреса Kafka-брокеров через запятую
KAFKA_BROKERS=localhost:9092

# Название топика с событиями "Заказ оплачен"
ORDER_PAID_TOPIC_NAME=order.paid

# Название топика с событиями "Сборка завершена"
ASSEMBLY_SHIP_ASSEMBLED_TOPIC_NAME=ship.assembled

# Идентификатор consumer group для обработки событий "Сборка корабля"
ASSEMBLY_SHIP_ASSEMBLED_CONSUMER_GROUP_ID=3